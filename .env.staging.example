# ═══ STAGING (Vercel „Preview“-Scope) ═══  Werte in Vercel eintragen – NICHT in eine Datei einchecken.
APP_ENV="staging"

# Eigene Staging-Datenbank (z. B. Neon-Branch/-Projekt „shop-staging“) – NIE dieselbe wie Production.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/shop_staging?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/shop_staging?sslmode=require"

NEXT_PUBLIC_APP_URL="https://staging.deine-domain.de"
NEXT_PUBLIC_SHOP_NAME="Lilli und Lou"
CRON_SECRET="<openssl rand -hex 32>"

STORAGE_DRIVER="s3"
S3_BUCKET="shop-staging"
S3_REGION="auto"
S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="<staging-key>"
S3_SECRET_ACCESS_KEY="<staging-secret>"

# Stripe: ausschließlich TEST-Modus
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
PAYPAL_CLIENT_ID="<sandbox-client-id>"
PAYPAL_CLIENT_SECRET="<sandbox-secret>"
PAYPAL_ENV="sandbox"

RESEND_API_KEY="re_..."
MAIL_FROM="Shop Staging <bestellung@staging.deine-domain.de>"

UPSTASH_REDIS_REST_URL="https://<name>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<token>"

# Nur für einmaligen Seed, danach entfernen:
# ADMIN_EMAIL, ADMIN_PASSWORD, ALLOW_DEMO_SEED=1
