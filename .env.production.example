# ═══ PRODUCTION (Vercel „Production“-Scope) ═══  Werte in Vercel eintragen – NICHT in eine Datei einchecken.
APP_ENV="production"

# Eigene Production-Datenbank. NIEMALS die lokale (lumi_shop) und nie die Staging-Datenbank.
# DATABASE_URL = gepoolt (Laufzeit), DIRECT_URL = direkt (Migrationen). TLS ist Pflicht.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/shop_production?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/shop_production?sslmode=require"

NEXT_PUBLIC_APP_URL="https://www.deine-domain.de"
NEXT_PUBLIC_SHOP_NAME="LUMI"
CRON_SECRET="<openssl rand -hex 32>"           # schützt /api/cron/* und /api/health?detail=1 (Vercel sendet ihn automatisch an Crons)

# Pflicht auf Vercel: S3-kompatibler, PRIVATER Bucket (Versionierung aktivieren)
STORAGE_DRIVER="s3"
S3_BUCKET="shop-production"
S3_REGION="auto"
S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="<nur Lese-/Schreibrechte auf diesen Bucket>"
S3_SECRET_ACCESS_KEY="<secret>"

# Stripe LIVE
STRIPE_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."              # aus dem Live-Webhook-Endpoint (…/api/webhooks/stripe)

PAYPAL_CLIENT_ID="<live-client-id>"
PAYPAL_CLIENT_SECRET="<live-secret>"
PAYPAL_ENV="live"

RESEND_API_KEY="re_..."
MAIL_FROM="Shop <bestellung@deine-domain.de>"  # Domain in Resend verifiziert (SPF/DKIM)

# Pflicht für wirksames Rate-Limiting auf Serverless
UPSTASH_REDIS_REST_URL="https://<name>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="<token>"

# NUR für den einmaligen Admin-Bootstrap (npm run db:seed:admin) in der SHELL setzen – danach nicht in Vercel belassen:
# ADMIN_EMAIL, ADMIN_PASSWORD (≥14 Zeichen), CONFIRM_PRODUCTION_SEED=yes
