# ═══ LOCAL (Entwicklung) ═══  Kopie nach .env – .env wird NIE eingecheckt.
APP_ENV="local"

# Lokale Entwicklungsdatenbank (eigene Instanz). Produktion/Staging verwenden NIE diese Datenbank.
DATABASE_URL="postgresql://USER@localhost:5432/lumi_shop?schema=public"
DIRECT_URL="postgresql://USER@localhost:5432/lumi_shop?schema=public"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SHOP_NAME="Lilli und Lou"
CRON_SECRET="change-me-local"

STORAGE_DRIVER="local"
STORAGE_DIR="./storage"

# Optional lokal: Stripe TEST-Keys (sk_test_/pk_test_), PayPal Sandbox, Resend
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="sandbox"
RESEND_API_KEY=""
MAIL_FROM="Lilli und Lou <shop@example.com>"

# Nur für `npm run db:seed` (lokal)
ADMIN_EMAIL="admin@lumi.local"
ADMIN_PASSWORD="change-me-Admin-1"
